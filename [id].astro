---
import MainLayout from '../../layouts/MainLayout.astro'; import {getCollection,render} from 'astro:content';
export async function getStaticPaths(){return (await getCollection('essays')).map(entry=>({params:{id:entry.id},props:{entry}}));}
const {entry}=Astro.props; const {Content}=await render(entry);
---
<MainLayout title={`${entry.data.title} | Through My Quiet Lens`} description={entry.data.description}><article class="essay wrap"><p class="eyebrow">Essay</p><h1>{entry.data.title}</h1><p class="dek">{entry.data.description}</p><p class="meta">{entry.data.published.toLocaleDateString('en-GB',{day:'numeric',month:'long',year:'numeric'})}</p><div class="prose"><Content/></div><aside><strong>Thank you for choosing to pause and explore.</strong><p>I hope you leave with a new question, a different perspective, or simply a reason to pause.</p></aside></article></MainLayout><style>.essay{max-width:760px;padding-top:5rem;padding-bottom:6rem}.essay h1{font-size:clamp(3rem,7vw,5.5rem);line-height:1.05;margin:.8rem 0}.dek{font-size:1.25rem;color:var(--muted)}.meta{font-size:.85rem;color:var(--muted);border-bottom:1px solid var(--line);padding-bottom:2rem}.prose{font-family:Georgia,"Times New Roman",serif;font-size:1.18rem}.prose :global(p){margin:1.5rem 0}.prose :global(strong){font-weight:600}aside{margin-top:4rem;border-top:1px solid var(--line);padding-top:2rem}</style>
